{
  "name": "@zemd/web",
  "version": "0.0.0",
  "private": true,
  "description": "Independent web packages maintained in a pnpm and Turborepo monorepo.",
  "homepage": "https://github.com/zemd/web#readme",
  "bugs": {
    "url": "https://github.com/zemd/web/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Dmytro Zelenetskyi",
    "email": "oss@zemd.dev",
    "url": "https://zemd.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zemd/web.git"
  },
  "funding": "https://github.com/sponsors/zemd",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test && node --test .github/scripts/package-contract.test.mjs .github/scripts/release-pr-body.test.mjs .github/scripts/release-workflow.test.mjs",
    "typecheck": "turbo run typecheck",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "lint": "oxlint --type-aware --fix",
    "lint-check": "oxlint --type-aware --deny-warnings",
    "lint-publish": "pnpm -r exec publint",
    "release-check": "pnpm run format-check && pnpm run lint-check && pnpm run typecheck && pnpm run build && pnpm run test && pnpm run lint-publish",
    "release-change": "pnpm change",
    "release-status": "pnpm change status",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "0.3.23",
    "turbo": "2.10.9"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
